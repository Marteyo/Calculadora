<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_horizontal_margin"
    tools:context="com.calculadora.usuario.calculadora.MainActivity">

    <TextView
        android:id="@+id/resultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom|end"
        android:maxLines="1"
        android:paddingBottom="8dp"
        android:text="0"
        android:textAppearance="@style/TextAppearance.AppCompat.Display2"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">

        <LinearLayout style="@style/CalcRow">
            <Button
                style="@style/CalcButton.Function"
                android:text="@string/clear"
                android:onClick="onBorrarTodo" />
            <Button
                style="@style/CalcButton.Function"
                android:text="@string/backspace"
                android:onClick="onBorrarUltimo" />
            <Button
                style="@style/CalcButton.Function"
                android:text="@string/percent"
                android:onClick="onPorcentaje" />
            <Button
                style="@style/CalcButton.Operator"
                android:text="@string/divide"
                android:tag="/"
                android:onClick="onOperador" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button
                style="@style/CalcButton"
                android:text="7"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="8"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="9"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton.Operator"
                android:text="@string/multiply"
                android:tag="*"
                android:onClick="onOperador" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button
                style="@style/CalcButton"
                android:text="4"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="5"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="6"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton.Operator"
                android:text="@string/subtract"
                android:tag="-"
                android:onClick="onOperador" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button
                style="@style/CalcButton"
                android:text="1"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="2"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton"
                android:text="3"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton.Operator"
                android:text="@string/add"
                android:tag="+"
                android:onClick="onOperador" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button
                style="@style/CalcButton.Function"
                android:text="@string/negate"
                android:onClick="onSigno" />
            <Button
                style="@style/CalcButton"
                android:text="0"
                android:onClick="onDigito" />
            <Button
                style="@style/CalcButton.Function"
                android:text="@string/decimal"
                android:onClick="onComa" />
            <Button
                style="@style/CalcButton.Equals"
                android:text="@string/equals"
                android:onClick="onIgual" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
